<?xml version="1.0" encoding="utf-8"?>
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">
  <assemblyIdentity version="1.0.0.0" name="UuvrLoader.app"/>
  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v2">
    <security>
      <requestedPrivileges xmlns="urn:schemas-microsoft-com:asm.v3">
        <!-- asInvoker: no admin prompt. Installing into Program Files may still need
             elevation, which the installer detects and reports instead of failing silently. -->
        <requestedExecutionLevel level="asInvoker" uiAccess="false" />
      </requestedPrivileges>
    </security>
  </trustInfo>
  <!--
    No dpiAware/dpiAwareness here on purpose. Declaring DPI awareness in the manifest
    conflicts with WinForms' own handling (build warning WFAC010) and leaves the app in
    whatever mode the manifest picked before WinForms initializes. The ApplicationHighDpiMode
    project property drives it through ApplicationConfiguration.Initialize() instead.
  -->
</assembly>
